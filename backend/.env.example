# Copy this file to .env and fill in values for local development
# In production (Render/Railway), set these as environment variables in the dashboard

# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: https://mockly.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Port is set automatically by Render/Railway — override only for local dev
# PORT=8000
